  "components": {
    "schemas": {
      "AttachmentInput": {
        "properties": {
          "data_base64": {
            "type": "string",
            "maxLength": 16000000,
            "title": "Data Base64"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ],
            "title": "Media Type"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data_base64",
          "media_type",
          "confirmed"
        ],
        "title": "AttachmentInput"
      },
      "AttachmentResponse": {
        "properties": {
          "attachment_id": {
            "type": "string",
            "title": "Attachment Id"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          }
        },
        "type": "object",
        "required": [
          "attachment_id",
          "sha256",
          "media_type",
          "size_bytes",
          "confirmed"
        ],
        "title": "AttachmentResponse"
      },
      "Capabilities": {
        "properties": {
          "harness": {
            "type": "string",
            "enum": [
              "ready",
              "not_configured",
              "unavailable"
            ],
            "title": "Harness",
            "default": "not_configured"
          },
          "question_answering": {
            "type": "string",
            "enum": [
              "ready",
              "not_configured",
              "unavailable"
            ],
            "title": "Question Answering",
            "default": "not_configured"
          },
          "persistence": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Persistence",
            "default": "unavailable"
          },
          "video": {
            "type": "string",
            "const": "not_implemented",
            "title": "Video",
            "default": "not_implemented"
          },
          "transcription": {
            "type": "string",
            "const": "not_implemented",
            "title": "Transcription",
            "default": "not_implemented"
          },
          "knowledge_base": {
            "type": "string",
            "const": "not_implemented",
            "title": "Knowledge Base",
            "default": "not_implemented"
          }
        },
        "type": "object",
        "title": "Capabilities"
      },
      "ChatResponse": {
        "properties": {
          "chat_id": {
            "type": "string",
            "title": "Chat Id"
          },
          "course_id": {
            "type": "string",
            "title": "Course Id"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            },
            "type": "array",
            "title": "Messages"
          },
          "generations": {
            "items": {
              "$ref": "#/components/schemas/GenerationResponse"
            },
            "type": "array",
            "title": "Generations"
          }
        },
        "type": "object",
        "required": [
          "chat_id",
          "course_id"
        ],
        "title": "ChatResponse"
      },
      "CourseInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "CourseInput"
      },
      "CourseResponse": {
        "properties": {
          "course_id": {
            "type": "string",
            "title": "Course Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "course_id",
          "title"
        ],
        "title": "CourseResponse"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse"
      },
      "GenerationResponse": {
        "properties": {
          "generation_id": {
            "type": "string",
            "title": "Generation Id"
          },
          "submission_id": {
            "type": "string",
            "title": "Submission Id"
          },
          "chat_id": {
            "type": "string",
            "title": "Chat Id"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "body": {
            "type": "string",
            "title": "Body",
            "default": ""
          },
          "reasoning": {
            "type": "string",
            "title": "Reasoning",
            "default": ""
          },
          "cancel_requested": {
            "type": "boolean",
            "title": "Cancel Requested",
            "default": false
          },
          "event_watermark": {
            "type": "integer",
            "title": "Event Watermark",
            "default": 0
          },
          "usage": {
            "$ref": "#/components/schemas/UsageResponse"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "type": "object",
        "required": [
          "generation_id",
          "submission_id",
          "chat_id",
          "state"
        ],
        "title": "GenerationResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "1",
