root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,css,html}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# The desktop entry runs in built-in Windows PowerShell 5.1, which requires
# a BOM to distinguish UTF-8 Chinese strings from the legacy ANSI code page.
[scripts/desktop/Launch-Desktop.ps1]
charset = utf-8-bom
