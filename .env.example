# Paths resolve relative to the project root. No model key reaches the frontend.
LEARNING_APP_BACKEND_PORT=8765
LEARNING_APP_FRONTEND_PORT=5173
LEARNING_APP_DATA_DIR=.runtime/app/data
LEARNING_APP_RUNTIME_DIR=.runtime/app/run
LEARNING_APP_HARNESS_ENABLED=false
# Official account is the default; API Key is an explicit alternative.
LEARNING_APP_CREDENTIAL_ROUTE=account
LEARNING_APP_MODEL=deepseek-flash
LEARNING_APP_THINKING=high
LEARNING_APP_MAX_OUTPUT_TOKENS=16384
LEARNING_APP_MODEL_TIMEOUT_SECONDS=300
LEARNING_APP_SECRET_FILE=.local/secrets/deepseek.env
